  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push",
