    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "cpanel:deploy": "prisma db push && npm run db:seed && npm run build",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
