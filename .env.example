# PostgreSQL (Neon, Supabase, Railway Postgres, or local Docker — see docker-compose.yml)
# On Railway: link the Postgres service and set DATABASE_URL=${{Postgres.DATABASE_URL}}
# Prefer the private URL when both services are in the same Railway project:
# DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DATABASE_URL="postgresql://baraka:baraka@localhost:5432/baraka?schema=public&connect_timeout=5"
# On a small Railway replica, keep the pool tiny, e.g. append:
# &connection_limit=2

# Session signing secret (openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Seed only — used by `npm run db:seed` to create the first admin. Not read by the running site.
ADMIN_EMAIL="admin@el-baraka-conseil.dz"
ADMIN_PASSWORD="change-me-now"

# SMTP (Gmail App Password, Brevo, Zoho, OVH…)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EL BARAKA CONSEIL <contact@el-baraka-conseil.dz>"
# Inbox that receives contact messages and applications
MAIL_TO="contact@el-baraka-conseil.dz"

# Optional. Used only if SMTP is missing or fails.
RESEND_API_KEY=""

# Storage — set Cloudinary OR Vercel Blob. If neither is set, files are stored on local disk
# (fine for a VPS; ephemeral on Vercel and Railway unless you mount a volume).
# On Railway: configure Cloudinary (recommended) so uploads survive redeploys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
BLOB_READ_WRITE_TOKEN=""

# Public WhatsApp number, international format without + (also editable in admin)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# WhatsApp Cloud API (Meta) — optional admin alerts
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_NUMBER=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="fr"

# Canonical site URL (no trailing slash). On Railway: https://your-service.up.railway.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salt for visitor IP hashes. Never store raw IPs. Rotate carefully (resets anonymous identity).
IP_HASH_SALT="replace-with-a-random-salt"

# Optional Google Analytics 4. Loaded only after the visitor accepts statistics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional Google Search Console verification token (the content value of the meta tag).
GOOGLE_SITE_VERIFICATION=""

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional Upstash Redis for distributed rate limiting. Without it, the app uses Postgres.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
