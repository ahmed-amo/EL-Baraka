# MariaDB / MySQL (Prisma provider = mysql — same URL for cPanel MariaDB)
# cPanel example: mysql://USER:PASSWORD@localhost:3306/elbarakaconseil_el_baraka
# Local Docker: npm run db:up  →  mysql://baraka:baraka@127.0.0.1:3306/baraka
# URL-encode special characters in the password (# → %23, @ → %40, etc.)
DATABASE_URL="mysql://baraka:baraka@127.0.0.1:3306/baraka"

# Session signing secret (openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Seed only — used by `npm run db:seed` to create the first admin. Not read by the running site.
ADMIN_EMAIL="admin@el-baraka-conseil.dz"
ADMIN_PASSWORD="change-me-now"

# SMTP (Gmail App Password, Brevo, Zoho, OVH / cPanel email…)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EL BARAKA CONSEIL <contact@el-baraka-conseil.dz>"
# Inbox that receives contact messages and applications
MAIL_TO="contact@el-baraka-conseil.dz"

# Optional. Used only if SMTP is missing or fails.
RESEND_API_KEY=""

# Storage — set Cloudinary OR Vercel Blob. If neither is set, files are stored on local disk
# (good on cPanel permanent disk under the app folder).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
BLOB_READ_WRITE_TOKEN=""

# Public WhatsApp number, international format without + (also editable in admin)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# WhatsApp Cloud API (Meta) — optional admin alerts
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_NUMBER=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="fr"

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://elbarakaconseil.dz"

# Optional CDN URL for the full hero video (Cloudinary, Blob…). Overrides DB /videos/hero.mp4.
# NEXT_PUBLIC_HERO_VIDEO_URL="https://res.cloudinary.com/…/hero.mp4"

# Salt for visitor IP hashes. Never store raw IPs. Rotate carefully (resets anonymous identity).
IP_HASH_SALT="replace-with-a-random-salt"

# Optional Google Analytics 4. Loaded only after the visitor accepts statistics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional Google Search Console verification token (the content value of the meta tag).
GOOGLE_SITE_VERIFICATION=""

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional Upstash Redis for distributed rate limiting. Without it, the app uses in-memory limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
