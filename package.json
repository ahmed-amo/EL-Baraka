    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.545.0",
    "next": "^15.5.29",
    "next-intl": "^4.3.9",
    "nodemailer": "^7.0.13",
    "prisma": "^6.16.2",
